---
import Button from "@/components/ui/button.astro";
const WEB3FORMS_KEY = import.meta.env.WEB3FORMS_KEY ?? "";
---

<!-- Newsletter signup form using Web3Forms with theme integration -->
<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="newsletter-form"
  class="needs-validation"
  novalidate>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <!-- Subject line for newsletter signups -->
  <input type="hidden" name="subject" value="Newsletter Signup" />
  <!-- Bot check -->
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />
  
  <div class="mb-5">
    <input
      type="text"
      placeholder="Your Name"
      required
      class="w-full px-4 py-3 border rounded-md focus:outline-none theme-card-bg theme-card-text"
      style="border-color: var(--color-theme-stroke);"
      name="name"
    />
    <div class="empty-feedback invalid-feedback text-sm mt-1" style="color: var(--color-theme-stroke);">
      Please provide your name.
    </div>
  </div>
  
  <div class="mb-5">
    <label for="newsletter_email_address" class="sr-only">Email Address</label>
    <input
      id="newsletter_email_address"
      type="email"
      placeholder="Email Address"
      name="email"
      required
      class="w-full px-4 py-3 border rounded-md focus:outline-none theme-card-bg theme-card-text"
      style="border-color: var(--color-theme-stroke);"
    />
    <div class="empty-feedback text-sm mt-1" style="color: var(--color-theme-stroke);">
      Please provide your email address.
    </div>
    <div class="invalid-feedback text-sm mt-1" style="color: var(--color-theme-stroke);">
      Please provide a valid email address.
    </div>
  </div>
  
  <Button type="submit" size="lg" block>
    Subscribe to Newsletter
  </Button>
  <div id="newsletter-result" class="mt-3 text-center theme-paragraph"></div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: var(--color-theme-stroke);
  }
</style>

<script is:inline>
  const newsletterForm = document.getElementById("newsletter-form");
  const newsletterResult = document.getElementById("newsletter-result");

  if (newsletterForm && newsletterResult) {
    newsletterForm.addEventListener("submit", function (e) {
      e.preventDefault();
      newsletterForm.classList.add("was-validated");
      if (!newsletterForm.checkValidity()) {
        newsletterForm.querySelectorAll(":invalid")[0].focus();
        return;
      }
      const formData = new FormData(newsletterForm);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      newsletterResult.innerHTML = "Subscribing...";
      newsletterResult.className = "mt-3 text-center theme-paragraph";

      fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
        },
        body: json,
      })
        .then(async (response) => {
          let json = await response.json();
          if (response.status == 200) {
            newsletterResult.style.color = "var(--color-theme-highlight)";
            newsletterResult.innerHTML = "Thank you! You've been subscribed to our newsletter.";
          } else {
            console.log(response);
            newsletterResult.style.color = "var(--color-theme-stroke)";
            newsletterResult.innerHTML = json.message;
          }
        })
        .catch((error) => {
          console.log(error);
          newsletterResult.style.color = "var(--color-theme-stroke)";
          newsletterResult.innerHTML = "Something went wrong!";
        })
        .then(function () {
          newsletterForm.reset();
          newsletterForm.classList.remove("was-validated");
          setTimeout(() => {
            newsletterResult.style.display = "none";
          }, 5000);
        });
    });
  }
</script>