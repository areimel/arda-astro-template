---
import Toast from '@/components/ui/Toast.astro';
import Button from '@/components/ui/button.astro';
import { Icon } from 'astro-icon/components';

const toastId = "tracking-consent-popup";
---

<Toast 
	id={toastId}
	position="bottom-right" 
	size="md"
	dismissible={false}
	class="tracking-consent-popup"
>
	<div class="space-y-4">
		<!-- Header -->
		<div class="flex items-start space-x-3">
			<div class="flex-shrink-0 mt-1">
				<!-- Privacy Icon -->
				<Icon name="bx:bx-lock-alt" class="w-6 h-6" style="color: var(--color-theme-headline);" />
			</div>
			<div class="flex-1 min-w-0">
				<h3 class="text-lg font-display font-bold theme-headline">
					Privacy & Cookies
				</h3>
			</div>
		</div>

		<!-- Content -->
		<div class="text-sm theme-paragraph font-sans leading-relaxed">
			<p class="mb-3">
				We use tracking technologies to improve your experience and analyze site usage. 
				Your privacy matters to us.
			</p>
			<p class="text-xs theme-paragraph opacity-80">
				Your choice will be remembered for 30 days. You can change this anytime in your browser settings.
			</p>
		</div>

		<!-- Action Buttons -->
		<div class="flex flex-col sm:flex-row gap-3 pt-2">
			<Button
				data-consent-action="allow"
				class="flex-1 text-sm justify-center"
				style="primary"
				size="md"
			>
				Allow
			</Button>
			<Button
				data-consent-action="deny"  
				class="flex-1 text-sm justify-center"
				style="outline"
				size="md"
			>
				Don't Allow
			</Button>
		</div>
	</div>
</Toast>

<script>
	import { 
		shouldShowConsentPopup, 
		handleConsentAction,
		initTrackingConsent 
	} from '@/utils/TrackingConsentStatus.js';

	interface ConsentPopupManager {
		init(): void;
		show(): void;
		hide(): void;
		handleAction(action: string): void;
		waitForToastSystem(): Promise<void>;
	}

	class TrackingConsentPopup implements ConsentPopupManager {
		private toastId = 'tracking-consent-popup';
		private isInitialized = false;
		private toastSystemReady = false;
		private maxWaitTime = 10000; // 10 seconds max wait

		async init(): Promise<void> {
			if (this.isInitialized) return;

			console.log('Initializing tracking consent popup...');

			// Initialize tracking consent system
			initTrackingConsent();

			// Wait for Toast system to be available
			await this.waitForToastSystem();

			// Set up event listeners
			this.setupEventListeners();

			// Check if popup should be shown on load
			if (shouldShowConsentPopup()) {
				console.log('Consent status unknown - showing popup after delay');
				// Small delay to ensure DOM is ready
				setTimeout(() => {
					this.show();
				}, 1000);
			} else {
				console.log('Consent already set - popup not needed');
			}

			this.isInitialized = true;
			console.log('Tracking consent popup initialized successfully');
		}

		async waitForToastSystem(): Promise<void> {
			return new Promise((resolve) => {
				const startTime = Date.now();
				
				const checkToastSystem = () => {
					// Check if Toast system is available
					if (typeof (window as any).showToast === 'function' && 
						typeof (window as any).hideToast === 'function') {
						this.toastSystemReady = true;
						console.log('Toast system detected and ready');
						resolve();
						return;
					}

					// Check if we've exceeded max wait time
					if (Date.now() - startTime > this.maxWaitTime) {
						console.warn('Toast system not available after waiting - proceeding anyway');
						resolve();
						return;
					}

					// Try again in 100ms
					setTimeout(checkToastSystem, 100);
				};

				checkToastSystem();
			});
		}

		private setupEventListeners(): void {
			// Handle consent action buttons
			document.addEventListener('click', (event) => {
				const target = event.target as HTMLElement;
				const actionButton = target.closest('[data-consent-action]') as HTMLElement;
				
				if (actionButton) {
					event.preventDefault();
					const action = actionButton.getAttribute('data-consent-action');
					if (action) {
						console.log(`Consent button clicked: ${action}`);
						this.handleAction(action);
					}
				}
			});

			// Listen for consent changes from other sources
			document.addEventListener('trackingConsentChanged', (event) => {
				const customEvent = event as CustomEvent;
				const { status } = customEvent.detail;
				
				console.log('Consent changed externally:', status);
				// Hide popup when consent is set from elsewhere
				if (status !== 'unknown') {
					this.hide();
				}
			});

			// Listen for toast events
			document.addEventListener('toastHidden', (event) => {
				const customEvent = event as CustomEvent;
				if (customEvent.detail.toastId === this.toastId) {
					console.log('Tracking consent popup hidden via toast event');
				}
			});

			document.addEventListener('toastShown', (event) => {
				const customEvent = event as CustomEvent;
				if (customEvent.detail.toastId === this.toastId) {
					console.log('Tracking consent popup shown via toast event');
				}
			});
		}

		show(): void {
			console.log('Attempting to show tracking consent popup...');
			
			// Use the global showToast function from Toast component
			if (typeof (window as any).showToast === 'function') {
				(window as any).showToast(this.toastId);
				console.log('Tracking consent popup shown');
			} else {
				console.error('Toast system not available - cannot show consent popup');
				// Fallback: try to show the element directly
				this.showFallback();
			}
		}

		hide(): void {
			console.log('Attempting to hide tracking consent popup...');
			
			// Use the global hideToast function from Toast component
			if (typeof (window as any).hideToast === 'function') {
				(window as any).hideToast(this.toastId);
				console.log('Tracking consent popup hidden');
			} else {
				console.error('Toast system not available - cannot hide consent popup');
				// Fallback: try to hide the element directly
				this.hideFallback();
			}
		}

		private showFallback(): void {
			const toast = document.querySelector(`[data-toast-id="${this.toastId}"]`) as HTMLElement;
			if (toast) {
				toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
				toast.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
				console.log('Consent popup shown via fallback method');
			} else {
				console.error('Consent popup element not found');
			}
		}

		private hideFallback(): void {
			const toast = document.querySelector(`[data-toast-id="${this.toastId}"]`) as HTMLElement;
			if (toast) {
				toast.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
				toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
				console.log('Consent popup hidden via fallback method');
			}
		}

		handleAction(action: string): void {
			console.log('Processing consent action:', action);
			
			// Save the consent choice
			const success = handleConsentAction(action);
			
			if (success) {
				// Hide the popup with a small delay for better UX
				setTimeout(() => {
					this.hide();
				}, 300);
				
				// Show confirmation message
				const actionText = action === 'allow' ? 'accepted' : 'declined';
				console.log(`Tracking consent ${actionText} successfully`);
			} else {
				console.error('Failed to save consent choice');
			}
		}
	}

	// Initialize the tracking consent popup
	if (typeof window !== 'undefined') {
		let consentPopup: TrackingConsentPopup;

		const initialize = async () => {
			try {
				consentPopup = new TrackingConsentPopup();
				await consentPopup.init();
				
				// Make available globally for debugging and external access
				(window as any).TrackingConsentPopup = consentPopup;
			} catch (error) {
				console.error('Failed to initialize tracking consent popup:', error);
			}
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initialize);
		} else {
			// Use setTimeout to ensure this runs after other scripts
			setTimeout(initialize, 0);
		}
	}
</script>

<style>
	.tracking-consent-popup {
		/* Ensure popup appears above other elements */
		z-index: 9999;
	}

	/* Responsive adjustments */
	@media (max-width: 640px) {
		.tracking-consent-popup {
			/* On mobile, use more of the screen */
			left: 1rem;
			right: 1rem;
			bottom: 1rem;
			max-width: none;
		}
	}

	/* Animation improvements */
	.tracking-consent-popup.opacity-100 {
		animation: slideInUp 0.4s ease-out;
	}

	.tracking-consent-popup.opacity-0 {
		animation: slideOutDown 0.3s ease-in;
	}

	@keyframes slideInUp {
		from {
			transform: translateY(100%);
			opacity: 0;
		}
		to {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@keyframes slideOutDown {
		from {
			transform: translateY(0);
			opacity: 1;
		}
		to {
			transform: translateY(20px);
			opacity: 0;
		}
	}
</style>