---
interface Props {
	modalId?: string;
	class?: string;
	[x: string]: any;
}

const { modalId, class: className, ...rest } = Astro.props;
---

<button
	type="button"
	data-modal-close={modalId}
	class:list={[
		"absolute top-4 right-4 p-2 rounded-full transition-colors",
		"hover:bg-opacity-10 focus:outline-none focus:ring-2 focus:ring-offset-2",
		className
	]}
	style="color: var(--color-theme-paragraph); background-color: var(--color-theme-card-bg); border: 1px solid var(--color-theme-stroke); --tw-ring-color: var(--color-theme-button);"
	aria-label="Close modal"
	title="Close modal"
	{...rest}
>
	<svg 
		class="w-5 h-5" 
		fill="none" 
		stroke="currentColor" 
		viewBox="0 0 24 24"
	>
		<path 
			stroke-linecap="round" 
			stroke-linejoin="round" 
			stroke-width="2" 
			d="M6 18L18 6M6 6l12 12"
		></path>
	</svg>
</button>