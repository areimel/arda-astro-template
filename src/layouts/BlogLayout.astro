---
import Container from "@/components/container.astro";
import RelatedContent from "@/components/RelatedContent.astro";
import ContextualLink from "@/components/ui/ContextualLink.astro";
import { getFormattedDate } from "@/utils/all";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;

// AI-optimized related content suggestions based on tags and category
const relatedItems = [
  {
    title: "Complete Guide to Web Development",
    href: "/blog/complete-guide-fullstack-development",
    type: "guide" as const,
    description: "Master modern web development with our comprehensive 2025 guide covering frontend, backend, and full-stack techniques.",
    relationship: "related" as const
  },
  {
    title: "Advanced Analytics Setup",
    href: "/analytics",
    type: "resource" as const,
    description: "Learn how to implement advanced analytics tracking for your web applications.",
    relationship: "related" as const
  },
  {
    title: "SEO Best Practices",
    href: "/seo",
    type: "guide" as const,
    description: "Comprehensive SEO strategies and implementation techniques for modern websites.",
    relationship: "related" as const
  },
  {
    title: "Accessibility Guidelines", 
    href: "/accessibility",
    type: "resource" as const,
    description: "Essential accessibility practices to make your website inclusive for all users.",
    relationship: "related" as const
  }
];
---

<Layout title={frontmatter.title}>
  <Container>
    <article class="mx-auto max-w-[735px] mt-14" itemscope itemtype="https://schema.org/BlogPosting">
      <header class="mb-8">
        <div class="mb-4">
          <span 
            class="uppercase tracking-wider text-sm font-medium px-3 py-1 rounded-full theme-button-primary text-white"
            itemprop="articleSection"
          >
            {frontmatter.category}
          </span>
        </div>
        
        <h1
          class="theme-headline text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight"
          itemprop="headline"
        >
          {frontmatter.title}
        </h1>
        
        <div class="flex gap-2 mt-4 items-center flex-wrap md:flex-nowrap">
          <span class="theme-paragraph opacity-75" itemprop="author">
            {frontmatter.author}
          </span>
          <span class="theme-paragraph opacity-50">•</span>
          <time 
            class="theme-paragraph opacity-75" 
            datetime={frontmatter.publishDate}
            itemprop="datePublished"
          >
            {getFormattedDate(frontmatter.publishDate)}
          </time>
          <span class="theme-paragraph opacity-50 hidden md:block">•</span>
          <div class="w-full md:w-auto flex flex-wrap gap-3">
            {frontmatter.tags.map((tag) => (
              <span 
                class="text-sm theme-paragraph opacity-60 hover:opacity-100 transition-opacity cursor-pointer"
                itemprop="keywords"
              >
                #{tag}
              </span>
            ))}
          </div>
        </div>
      </header>
    </article>

    <div class="mx-auto prose prose-lg mt-6 theme-paragraph" itemprop="articleBody">
      <slot />
    </div>
    
    <!-- AI-optimized related content section -->
    <div class="mx-auto max-w-[735px]">
      <RelatedContent 
        title="Continue Learning" 
        items={relatedItems}
        layout="cards"
        maxItems={4}
        class="mt-12 mb-8"
      />
    </div>
    
    <div class="text-center mt-8">
      <ContextualLink
        href="/blog"
        relationship="parent"
        contentType="resource"
        context="Return to blog listing page"
        variant="button"
        class="inline-flex items-center gap-2"
      >
        ← Back to Blog
      </ContextualLink>
    </div>
  </Container>
</Layout>
