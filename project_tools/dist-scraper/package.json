{
  "name": "@arda/dist-scraper",
  "version": "1.0.0",
  "description": "CLI tool for scraping Astro dist folder content to generate llms.txt file",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dist-scraper": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "turndown": "^7.2.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/turndown": "^5.0.4",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "astro",
    "llms",
    "cli",
    "content-scraping",
    "ai-seo"
  ]
}